node_modules/
.next/
out/
build/

# Local env files (with real API keys)
.env.local
.env*.local

# Database
*.db
*.db-journal
prisma/*.db

# User-uploaded assets (don't ship into git)
public/uploads/*
!public/uploads/.gitkeep

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
.claude/

# TypeScript incremental build cache
*.tsbuildinfo

# pnpm internal probes (atomic-write detection); harmless 0-byte files
# left behind when the installer is interrupted.
.__unlink_probe__
_tmp_*

# Logs
*.log
npm-debug.log*
