# This file is for Prisma CLI to find DATABASE_URL.
# AI keys and other secrets live in .env.local instead.
DATABASE_URL="file:./dev.db"

# Use the npmmirror Prisma engines mirror — Prisma's default CDN is slow/blocked
# in mainland China; this saves several minutes on `prisma generate`.
PRISMA_ENGINES_MIRROR=https://registry.npmmirror.com/-/binary/prisma
