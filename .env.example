# =====================================================
# Echo Album — Server-side environment variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored.
# =====================================================

# ----- Unified OpenAI-compatible gateway -----
# Examples:
#   openai-next:  https://api.openai-next.com/v1
#   OpenAI:       https://api.openai.com/v1
#   OpenRouter:   https://openrouter.ai/api/v1
AI_BASE_URL=
AI_API_KEY=

# Model ids — must be supported by the gateway above.
# A single gemini-3.1-flash-lite-preview handles both LLM tasks (memory card,
# query plan, rerank) and vision (image caption + OCR + tags). Benchmarked
# against deepseek-v3.2 / gemini-3-flash-preview / qwen-vl-*: lite-preview
# wins on latency in both roles with comparable or better output quality.
LLM_MODEL=gemini-3.1-flash-lite-preview
VISION_MODEL=gemini-3.1-flash-lite-preview
ASR_MODEL=whisper-large-v3

# ----- Database -----
# Postgres connection string. Use Neon's pooled URL (?sslmode=require&pgbouncer=true)
# for serverless deployments. For pure local dev you can run a local Postgres
# (e.g. `docker run -p 5432:5432 -e POSTGRES_PASSWORD=dev postgres:16`).
DATABASE_URL=

# ----- Vercel Blob (uploads) -----
# Auto-injected by `vercel env pull` once Blob is enabled on the project.
# Local dev: create a token at https://vercel.com/dashboard/stores
BLOB_READ_WRITE_TOKEN=

# ----- API access control -----
# Required header for every /api/* request when set:
#   Authorization: Bearer <API_TOKEN>
# Leave blank during local browser dev to disable the check.
# Generate a strong value with: openssl rand -hex 32
API_TOKEN=

# ----- Client-side mirrors (browser + Capacitor APK) -----
# NEXT_PUBLIC_API_TOKEN must equal API_TOKEN (sent on every request).
# NEXT_PUBLIC_API_BASE is empty in dev (same-origin); set to the tunnel /
# production URL when building the APK so the bundled JS knows where to call.
NEXT_PUBLIC_API_TOKEN=
NEXT_PUBLIC_API_BASE=
